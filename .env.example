APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

DATABASE_URL=postgresql+asyncpg://airvision:airvision@localhost:5432/airvision
DATABASE_URL_SYNC=postgresql://airvision:airvision@localhost:5432/airvision
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=airvision_scientific

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_REASONING_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

OPENWEATHER_API_KEY=
WAQI_API_KEY=
AQICN_TOKEN=

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AGENT_PER_MINUTE=20

OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=airvision-intelligence
ENABLE_TRACING=false

USE_LIVE_OSM=true
USE_MOCK_AQI_FALLBACK=true
ENABLE_VISION_AGENT=true
ENABLE_VOICE=false
